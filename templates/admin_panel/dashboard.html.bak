{% extends "admin_panel/base.html" %}

{% block page_title %}Dashboard Overview{% endblock %}

{% block content %}
<style>
    .dashboard-top {
        display: flex;
        justify-content: space-between;
        gap: 18px;
        align-items: flex-start;
        margin-bottom: 28px;
        flex-wrap: wrap;
    }
    .dashboard-intro {
        max-width: 700px;
    }
    .dashboard-label {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 16px;
        border-radius: 999px;
        background: rgba(141, 127, 255, 0.12);
        color: #c8cffe;
        font-size: 12px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin-bottom: 18px;
    }
    .dashboard-intro h1 {
        font-size: 36px;
        color: #f8fbff;
        line-height: 1.1;
        margin-bottom: 12px;
    }
    .dashboard-intro p {
        color: #b8c1e5;
        line-height: 1.7;
        font-size: 15px;
        max-width: 640px;
    }
    .dashboard-meta {
        display: grid;
        grid-template-columns: repeat(2, minmax(180px, 1fr));
        gap: 16px;
        width: min(100%, 420px);
    }
    .meta-card {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 22px;
        padding: 20px 22px;
        color: #edf2ff;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }
    .meta-card span {
        color: #8ca3f0;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }
    .meta-card strong {
        font-size: 26px;
        line-height: 1.1;
    }
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 18px;
        margin-bottom: 28px;
    }
    .stat-card {
        background: linear-gradient(180deg, rgba(255,255,255,0.04), rgba(255,255,255,0.02));
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 24px;
        padding: 24px;
        transition: transform 0.2s ease, border-color 0.2s ease;
    }
    .stat-card:hover {
        transform: translateY(-3px);
        border-color: rgba(141,127,255,0.4);
    }
    .stat-metric {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
    }
    .stat-metric span {
        font-size: 14px;
        color: #9db0ff;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }
    .stat-value {
        font-size: 34px;
        color: #f8fbff;
        font-weight: 700;
    }
    .stat-description {
        font-size: 13px;
        color: #93a4df;
        line-height: 1.6;
    }
    .actions-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 18px;
        margin-bottom: 28px;
    }
    .action-card {
        display: flex;
        align-items: flex-start;
        gap: 16px;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 24px;
        padding: 22px;
        color: #eeefff;
        text-decoration: none;
        transition: transform 0.2s ease, background 0.2s ease;
    }
    .action-card:hover {
        transform: translateY(-3px);
        background: rgba(141,127,255,0.09);
    }
    .action-icon {
        width: 48px;
        height: 48px;
        border-radius: 16px;
        background: rgba(255,255,255,0.08);
        display: grid;
        place-items: center;
        font-size: 20px;
    }
    .action-text {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }
    .action-title {
        font-size: 15px;
        font-weight: 700;
        color: #f8fbff;
    }
    .action-subtitle {
        font-size: 13px;
        color: #a9b2e3;
        line-height: 1.6;
    }
    .content-grid {
        display: grid;
        grid-template-columns: 1.7fr 1.3fr;
        gap: 20px;
        margin-bottom: 28px;
    }
    .section-card {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 24px;
        padding: 24px;
    }
    .section-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 20px;
    }
    .section-head h2 {
        font-size: 18px;
        margin: 0;
        color: #f8fbff;
    }
    .section-link {
        color: #adb8ff;
        font-size: 13px;
        text-decoration: none;
        font-weight: 600;
    }
    .section-link:hover {
        color: #ffffff;
    }
    .data-table {
        width: 100%;
        border-collapse: collapse;
        color: #eef1ff;
        font-size: 14px;
    }
    .data-table th,
    .data-table td {
        padding: 16px 14px;
        border-bottom: 1px solid rgba(255,255,255,0.08);
    }
    .data-table th {
        font-size: 12px;
        color: #8da0ff;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }
    .data-table tr:hover {
        background: rgba(255,255,255,0.03);
    }
    .status-pill {
        display: inline-flex;
        align-items: center;
        padding: 8px 12px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
    }
    .status-pending { background: rgba(255, 188, 68, 0.16); color: #ffb347; }
    .status-confirmed { background: rgba(84, 227, 173, 0.16); color: #42c77a; }
    .status-completed { background: rgba(128, 170, 255, 0.16); color: #7a9dff; }
    .status-cancelled { background: rgba(255, 114, 114, 0.16); color: #ff7b7b; }
    .empty-state {
        padding: 28px;
        text-align: center;
        color: #9da8dc;
        font-size: 14px;
    }
    .module-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 20px;
    }
    .module-card {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 24px;
        padding: 24px;
        min-height: 158px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }
    .module-title {
        font-size: 16px;
        color: #f8fbff;
        font-weight: 700;
        margin-bottom: 12px;
    }
    .module-desc {
        color: #aab4e1;
        font-size: 13px;
        line-height: 1.75;
        flex: 1;
    }
    .module-btn {
        color: #b0c1ff;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
    }
    .module-btn:hover {
        color: #ffffff;
    }
    @media (max-width: 1120px) {
        .stats-grid, .actions-grid, .module-grid, .dashboard-meta { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .content-grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 760px) {
        .dashboard-top { flex-direction: column; }
        .dashboard-meta { grid-template-columns: 1fr; width: 100%; }
        .stats-grid, .actions-grid, .module-grid { grid-template-columns: 1fr; }
    }
</style>

<div class="dashboard-top">
    <div class="dashboard-intro">
        <div class="dashboard-label">Bite Administration</div>
        <h1>Administration Dashboard</h1>
        <p>Overview of your spa operations, revenue metrics, and pending administrative tasks.</p>
    </div>
    <div class="dashboard-meta">
        <div class="meta-card">
            <span>Total Customers</span>
            <strong>{{ total_customers|default:"0" }}</strong>
        </div>
        <div class="meta-card">
            <span>Total Revenue</span>
            <strong>?{{ total_revenue|default:"0"|floatformat:0 }}</strong>
        </div>
    </div>
</div>

<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-metric">
            <span>Total Bookings</span>
            <div class="stat-value">{{ total_bookings|default:"0" }}</div>
        </div>
        <div class="stat-description">Total number of booking records across the spa.</div>
    </div>
    <div class="stat-card">
        <div class="stat-metric">
            <span>Today's Revenue</span>
            <div class="stat-value">?{{ today_revenue|default:"0"|floatformat:0 }}</div>
        </div>
        <div class="stat-description">Revenue collected from verified payments today.</div>
    </div>
    <div class="stat-card">
        <div class="stat-metric">
            <span>Pending Payments</span>
            <div class="stat-value">{{ pending_payments_count|default:"0" }}</div>
        </div>
        <div class="stat-description">Payments waiting for verification from customers.</div>
    </div>
    <div class="stat-card">
        <div class="stat-metric">
            <span>Active Today</span>
            <div class="stat-value">{{ active_staff|default:"0" }}</div>
        </div>
        <div class="stat-description">Staff currently checked in and working today.</div>
    </div>
</div>

<div class="actions-grid">
    <a href="{% url 'admin_panel:bookings' %}" class="action-card">
        <div class="action-icon">+</div>
        <div class="action-text">
            <div class="action-title">New Booking</div>
            <div class="action-subtitle">Create or review bookings.</div>
        </div>
    </a>
    <a href="{% url 'admin_panel:services' %}" class="action-card">
        <div class="action-icon">??</div>
        <div class="action-text">
            <div class="action-title">Add Service</div>
            <div class="action-subtitle">Manage treatments and categories.</div>
        </div>
    </a>
    <a href="{% url 'admin_panel:edit_staff' %}" class="action-card">
        <div class="action-icon">??</div>
        <div class="action-text">
            <div class="action-title">Add Staff</div>
            <div class="action-subtitle">Update staff and shift assignments.</div>
        </div>
    </a>
    <a href="{% url 'admin_panel:revenue' %}" class="action-card">
        <div class="action-icon">??</div>
        <div class="action-text">
            <div class="action-title">Generate Reports</div>
            <div class="action-subtitle">View revenue and booking trends.</div>
        </div>
    </a>
</div>

<div class="content-grid">
    <section class="section-card">
        <div class="section-head">
            <h2>Pending Payments (GCash)</h2>
            <a class="section-link" href="{% url 'admin_panel:payments' %}">View all payments</a>
        </div>
        {% if pending_payments_list %}
        <table class="data-table">
            <thead>
                <tr>
                    <th>Customer</th>
                    <th>Booking</th>
                    <th>Amount</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                {% for payment in pending_payments_list %}
                <tr>
                    <td>{{ payment.booking.customer.username }}</td>
                    <td>#{{ payment.booking.id }}</td>
                    <td>?{{ payment.amount|floatformat:2 }}</td>
                    <td><span class="status-pill status-pending">Pending</span></td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% else %}
        <div class="empty-state">No pending payments at the moment.</div>
        {% endif %}
    </section>

    <section class="section-card">
        <div class="section-head">
            <h2>Recent Bookings</h2>
            <a class="section-link" href="{% url 'admin_panel:bookings' %}">View all bookings</a>
        </div>
        {% if recent_bookings %}
        <table class="data-table">
            <thead>
                <tr>
                    <th>Customer</th>
                    <th>Service</th>
                    <th>Date</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                {% for booking in recent_bookings %}
                <tr>
                    <td>{{ booking.customer.username }}</td>
                    <td>{% if booking.service %}{{ booking.service.name }}{% elif booking.package %}{{ booking.package.name }}{% else %}-{% endif %}</td>
                    <td>{{ booking.booking_date }}</td>
                    <td>
                        <span class="status-pill {% if booking.status == 'pending' %}status-pending{% elif booking.status == 'confirmed' %}status-confirmed{% elif booking.status == 'completed' %}status-completed{% else %}status-cancelled{% endif %}">
                            {{ booking.status|title }}
                        </span>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% else %}
        <div class="empty-state">No recent bookings available.</div>
        {% endif %}
    </section>
</div>

<div class="module-grid">
    <div class="module-card">
        <div>
            <div class="module-title">Accounts</div>
            <div class="module-desc">Manage user profiles, login activity, and customer records.</div>
        </div>
        <a class="module-btn" href="{% url 'admin_panel:user_info' %}">Open Accounts ?</a>
    </div>
    <div class="module-card">
        <div>
            <div class="module-title">Marketing</div>
            <div class="module-desc">Manage services, packages, rooms and promotions.</div>
        </div>
        <a class="module-btn" href="{% url 'admin_panel:services' %}">Open Services ?</a>
    </div>
    <div class="module-card">
        <div>
            <div class="module-title">System</div>
            <div class="module-desc">Track revenue, payment status, and business analytics.</div>
        </div>
        <a class="module-btn" href="{% url 'admin_panel:revenue' %}">Open System ?</a>
    </div>
    <div class="module-card">
        <div>
            <div class="module-title">Bookings</div>
            <div class="module-desc">Control bookings and room assignments in one place.</div>
        </div>
        <a class="module-btn" href="{% url 'admin_panel:bookings' %}">Open Bookings ?</a>
    </div>
</div>
{% endblock %}
